

# ── LLM (OpenAI-compatible endpoint) ──────────────────────────────────────────
# Standard OpenAI:
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1       # sampling temperature (0 = deterministic)
LLM_TIMEOUT=30.0          # seconds before the HTTP request times out
LLM_MAX_RETRIES=3         # max retries on rate-limit / 5xx errors

# EPAM AI DIAL — uncomment and fill in:
# OPENAI_API_BASE=https://your-dial-host/openai
# OPENAI_API_KEY=your-dial-api-key
# OPENAI_MODEL=gpt-4

# ── Embeddings ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=parking_static

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./parking.db

# ── App ────────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── RAG ────────────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
