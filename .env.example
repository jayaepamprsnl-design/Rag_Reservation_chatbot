
# ── LLM (OpenAI-compatible endpoint) ──────────────────────────────────────────
# Standard OpenAI:
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=3

# EPAM AI DIAL — uncomment and fill in:
# OPENAI_API_BASE=https://your-dial-host/openai
# OPENAI_API_KEY=your-dial-api-key
# OPENAI_MODEL=gpt-4

# ── Embeddings ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=parking_static

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./parking.db

# ── App ────────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── RAG ────────────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5

# ── Admin API (Stage 2) ────────────────────────────────────────────────────────
# Base URL where the API is reachable from inside other containers.
# For local development leave as http://localhost:8000.
# In docker-compose this is overridden to http://api:8000.
ADMIN_API_BASE_URL=http://localhost:8000

# Secret key that protects every /admin/* endpoint.
# CHANGE THIS before deploying — use a long random string.
ADMIN_API_KEY=change-me-before-production

# ── Email channel (Stage 2, optional) ─────────────────────────────────────────
# Set ADMIN_EMAIL_ENABLED=true to send approval-request emails to the admin.
# For local dev, use the Mailpit service (docker compose --profile mailpit up).
ADMIN_EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Address that receives admin notifications.
ADMIN_EMAIL=admin@citypark.example.com
EMAIL_FROM=no-reply@citypark.example.com

# Secret for signing single-use email action tokens.
# CHANGE THIS before deploying — any long random string.
EMAIL_TOKEN_SECRET=change-me-in-production
EMAIL_TOKEN_MAX_AGE_SECONDS=86400

# ── MCP reservations server (Stage 3) ─────────────────────────────────────────
# Run: python scripts/run_mcp_server.py   (endpoint: http://MCP_HOST:MCP_PORT/mcp)
# These host/port/path values are for running on your machine. docker-compose.yml
# fixes its own container values (0.0.0.0:8765, /data/output/...) and
# MCP_SERVER_URL=http://mcp-server:8765/mcp, so only MCP_API_KEY is read from here.
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Required, min. 16 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=
RESERVATIONS_FILE=data/output/confirmed_reservations.txt
MCP_RATE_LIMIT_PER_MINUTE=120

# MCP client used by the API after an admin approval (Stage 3).
# MCP_API_KEY must equal the key the MCP server runs with; leave empty to disable the export.
MCP_EXPORT_ENABLED=true
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
MCP_CLIENT_TIMEOUT=5.0
MCP_CLIENT_MAX_ATTEMPTS=3
MCP_CLIENT_BACKOFF_SECONDS=0.5
MCP_RETRY_INTERVAL_SECONDS=60
